{
  "multipart": [
    { "when": { "facing": "north" }, "apply": { "model": "refractory:block/cable_machine" } },
    { "when": { "facing": "east" },  "apply": { "model": "refractory:block/cable_machine", "y": 90 } },
    { "when": { "facing": "south" }, "apply": { "model": "refractory:block/cable_machine", "y": 180 } },
    { "when": { "facing": "west" },  "apply": { "model": "refractory:block/cable_machine", "y": 270 } },
    { "when": { "has_crank": "true" }, "apply": { "model": "refractory:block/cable_machine_crank" } }
  ]
}
